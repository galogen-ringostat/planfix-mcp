{
  "name": "planfix-mcp-ringostat",
  "version": "1.2.0",
  "private": true,
  "description": "MCP server for the Planfix REST API v2 — tasks, projects, comments, time tracking, custom fields, files (Ringostat fork of theYahia/planfix-mcp)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "planfix-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "planfix",
    "project-management",
    "crm",
    "streamable-http",
    "smithery",
    "api",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/galogen-ringostat/planfix-mcp.git"
  },
  "homepage": "https://github.com/galogen-ringostat/planfix-mcp#readme",
  "author": "Galogen (Ringostat); upstream: theYahia (https://github.com/theYahia)"
}
